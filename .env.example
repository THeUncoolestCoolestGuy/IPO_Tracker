# ==============================================================================
# IPO TRACKER & GMP ALERT CONFIGURATION
# ==============================================================================

# Target mobile numbers to receive alerts (comma-separated, with country code)
PHONE_NUMBERS=+91XXXXXXXXXX,+91XXXXXXXXXX

# Minimum Grey Market Premium (GMP) percentage to trigger alerts
GMP_THRESHOLD_PERCENT=10.0

# Active notification channels (comma-separated):
# Options: console, telegram, fast2sms, callmebot, whatsapp_web, twilio_sms, twilio_whatsapp
# You can enable multiple channels at once (e.g. console,telegram,whatsapp_web)
NOTIFICATION_CHANNELS=console,telegram

# ------------------------------------------------------------------------------
# Fast2SMS Configuration (India SMS Gateway)
# Sign up at https://www.fast2sms.com/ to get your free API key
# ------------------------------------------------------------------------------
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ------------------------------------------------------------------------------
# Twilio Configuration (Optional - for SMS or WhatsApp)
# Sign up at https://www.twilio.com/
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ------------------------------------------------------------------------------
# Telegram Bot Configuration (100% Free Push Notifications)
# Create a bot with @BotFather to get your token, and send /start to your bot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# ------------------------------------------------------------------------------
# WhatsApp Alert Options:
# 1. callmebot: 100% Free WhatsApp Gateway (Runs 24/7 in Cloud & Local)
#    Each number activates once by sending a message to CallMeBot on WhatsApp
#    Format: +91XXXXXXXXXX:apikey1,+91YYYYYYYYYY:apikey2
# 2. whatsapp_web: Personal WhatsApp Web automation on your laptop
#    Format: +91XXXXXXXXXX,+91YYYYYYYYYY
# ------------------------------------------------------------------------------
CALLMEBOT_RECIPIENTS=
WHATSAPP_PHONE_NUMBERS=

# ------------------------------------------------------------------------------
# Schedule Timings (in IST - 24-hour format HH:MM)
# ------------------------------------------------------------------------------
MORNING_SCHEDULE_TIME=08:00
REMINDER_SCHEDULE_TIME=12:30
TIMEZONE=Asia/Kolkata

# Referral / Demat account opening links (Optional)
ZERODHA_REFERRAL_URL=https://zerodha.com/open-account?c=your_code_here
UPSTOX_REFERRAL_URL=https://upstox.onelink.me/your_code_here

# Stay silent and send no message if no Mainboard IPO has GMP > 10%
SILENT_ON_EMPTY=true
